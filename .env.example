# Copiar a server/.env y completar. NO commitear el .env real (está gitignored).

# --- Jira Cloud ---
JIRA_BASE_URL=https://tu-dominio.atlassian.net
JIRA_EMAIL=tu@email.com
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
# Uno o varios board IDs separados por coma
JIRA_BOARD_IDS=123,456

# --- Clasificación de talla (S/M/L/XL) con Google Gemini ---
GEMINI_API_KEY=
# Alias que sigue al flash-lite vigente; o fijá uno concreto (ej. gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-flash-lite-latest

# --- Opcionales ---
SYNC_INTERVAL_MINUTES=30
AGING_THRESHOLD_DAYS=7
